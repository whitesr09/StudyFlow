<?xml version="1.0" encoding="utf-8"?>
<!-- Phase F hold: no-op alpha 1 -> 1 on the root mark group. Keeps the AVD's
     total duration at exactly 980 ms so the final settled logo is held, with
     zero motion, until the system hands over to the app. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:propertyName="alpha" android:valueFrom="1" android:valueTo="1"
    android:valueType="floatType" android:duration="980" android:startOffset="0" />
