<?xml version="1.0" encoding="utf-8"?>
<!-- optionalGlowLayer alpha: off until 683 ms, gentle cyan pulse peaking at
     750 ms, fully removed by 900 ms (Phase F is clean). Translucent vector
     copies only - AVD has no blur. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="together">
    <objectAnimator android:propertyName="alpha" android:valueFrom="0" android:valueTo="0"
        android:valueType="floatType" android:duration="683" android:startOffset="0" android:interpolator="@android:interpolator/linear" />
    <objectAnimator android:propertyName="alpha" android:valueFrom="0" android:valueTo="0.16"
        android:valueType="floatType" android:duration="67" android:startOffset="683" android:interpolator="@android:interpolator/fast_out_slow_in" />
    <objectAnimator android:propertyName="alpha" android:valueFrom="0.16" android:valueTo="0.05"
        android:valueType="floatType" android:duration="67" android:startOffset="750" android:interpolator="@android:interpolator/linear" />
    <objectAnimator android:propertyName="alpha" android:valueFrom="0.05" android:valueTo="0"
        android:valueType="floatType" android:duration="83" android:startOffset="817" android:interpolator="@android:interpolator/linear" />
</set>
