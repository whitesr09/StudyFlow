<?xml version="1.0" encoding="utf-8"?>
<!-- Phase A (0-100 ms): start dot wake-up. Cubic ease-out (fast_out_slow_in). -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="together">
    <objectAnimator android:propertyName="alpha" android:valueFrom="0" android:valueTo="1"
        android:valueType="floatType" android:duration="100" android:startOffset="0"
        android:interpolator="@android:interpolator/fast_out_slow_in" />
    <objectAnimator android:propertyName="scaleX" android:valueFrom="0.84" android:valueTo="1"
        android:valueType="floatType" android:duration="100" android:startOffset="0"
        android:interpolator="@android:interpolator/fast_out_slow_in" />
    <objectAnimator android:propertyName="scaleY" android:valueFrom="0.84" android:valueTo="1"
        android:valueType="floatType" android:duration="100" android:startOffset="0"
        android:interpolator="@android:interpolator/fast_out_slow_in" />
</set>
