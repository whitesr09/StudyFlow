<?xml version="1.0" encoding="utf-8"?>
<!-- journeyPath trimPathEnd: hold 0 until 100 ms, 0.32 @300, 0.75 @533, 1.0 @683.
     Linear mid-segments keep the draw speed continuous; the last segment eases out. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="together">
    <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="0"
        android:valueType="floatType" android:duration="100" android:startOffset="0"
        android:interpolator="@android:interpolator/linear" />
    <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="0.32"
        android:valueType="floatType" android:duration="200" android:startOffset="100"
        android:interpolator="@android:interpolator/linear" />
    <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0.32" android:valueTo="0.75"
        android:valueType="floatType" android:duration="233" android:startOffset="300"
        android:interpolator="@android:interpolator/linear" />
    <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0.75" android:valueTo="1"
        android:valueType="floatType" android:duration="150" android:startOffset="533"
        android:interpolator="@android:interpolator/fast_out_slow_in" />
</set>
