<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#A6E8CD</item>
        <item name="android:windowBackground">#0B1220</item>
        <item name="android:navigationBarColor">#0B1220</item>
        <item name="android:statusBarColor">#0B1220</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="LaunchTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/studyflow_splash_bg</item>
        <item name="android:statusBarColor">@color/studyflow_splash_bg</item>
        <item name="android:navigationBarColor">@color/studyflow_splash_bg</item>
    </style>
</resources>
